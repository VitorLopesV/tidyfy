@startuml application
title Tidyfy — Aplicação (casos de uso e portas)

skinparam shadowing false
skinparam classAttributeIconSize 0
set namespaceSeparator none
hide empty members

package "com.tidyfy.application.usecase" {

  class SaveHelperUseCase {
    - repository : HelperRepository
    - scheduler : TaskScheduler
    - rules : HelperRules
    + execute(helper : Helper) : void
  }

  class RemoveHelperUseCase {
    - repository : HelperRepository
    - scheduler : TaskScheduler
    + execute(ids : Collection<HelperId>) : void
  }

  class ListHelpersUseCase {
    - repository : HelperRepository
    + execute() : List<Helper>
  }

  class ListExecutionHistoryUseCase {
    - history : ExecutionHistoryRepository
    + execute(id : HelperId) : List<ExecutionRecord>
  }

  class RunHelperUseCase {
    - repository : HelperRepository
    - organizeFolder : OrganizeFolderUseCase
    - cleanup : CleanupUseCase
    - history : ExecutionHistoryRepository
    - clock : Clock
    + execute(id : HelperId) : Optional<ExecutionRecord>
  }

  class OrganizeFolderUseCase {
    - fileSystem : FileSystem
    - planner : FolderOrganizationPlanner
    + execute(helper : FolderOrganizerHelper) : List<HelperAction>
  }

  class CleanupUseCase {
    - fileSystem : FileSystem
    - recycleBin : RecycleBin
    - clock : Clock
    + execute(helper : CleanerHelper) : List<HelperAction>
  }
}

package "com.tidyfy.application.port" {

  interface HelperRepository {
    + save(helper : Helper) : void
    + findById(id : HelperId) : Optional<Helper>
    + findAll() : List<Helper>
    + countByType(type : HelperType) : int
    + delete(id : HelperId) : void
  }

  interface ExecutionHistoryRepository {
    + add(record : ExecutionRecord) : void
    + findByHelper(id : HelperId) : List<ExecutionRecord>
    + deleteExpired(now : Instant) : void
  }

  interface TaskScheduler {
    + register(helper : Helper) : void
    + unregister(id : HelperId) : void
  }

  interface FileSystem {
    + listEntries(folder : Path) : List<FolderEntry>
    + exists(path : Path) : boolean
    + sameContent(first : Path, second : Path) : boolean
    + move(move : FileMove) : void
    + moveToTrash(path : Path) : void
  }

  interface RecycleBin {
    + emptyAll() : int
    + emptyOlderThan(cutoff : Instant) : int
  }
}

package "com.tidyfy.domain" {
  interface Helper
  enum HelperType
  class FolderOrganizerHelper
  class CleanerHelper
  class HelperRules
  class FolderOrganizationPlanner
  class NumberedName
  class FolderEntry
  class ExecutionRecord
  class HelperAction
}

SaveHelperUseCase --> HelperRepository
SaveHelperUseCase --> TaskScheduler
SaveHelperUseCase --> HelperRules
RemoveHelperUseCase --> HelperRepository
RemoveHelperUseCase --> TaskScheduler
ListHelpersUseCase --> HelperRepository
ListExecutionHistoryUseCase --> ExecutionHistoryRepository
RunHelperUseCase --> HelperRepository
RunHelperUseCase --> OrganizeFolderUseCase
RunHelperUseCase --> CleanupUseCase
RunHelperUseCase --> ExecutionHistoryRepository
OrganizeFolderUseCase --> FileSystem
OrganizeFolderUseCase --> FolderOrganizationPlanner
OrganizeFolderUseCase ..> NumberedName
CleanupUseCase --> FileSystem
CleanupUseCase --> RecycleBin

SaveHelperUseCase ..> Helper
SaveHelperUseCase ..> HelperType : assertCanCreate
RunHelperUseCase ..> Helper
RunHelperUseCase ..> ExecutionRecord : cria
OrganizeFolderUseCase ..> FolderOrganizerHelper
OrganizeFolderUseCase ..> HelperAction : devolve
CleanupUseCase ..> CleanerHelper
CleanupUseCase ..> HelperAction : devolve
FileSystem ..> FolderEntry
ExecutionHistoryRepository ..> ExecutionRecord

note right of SaveHelperUseCase
  1. Ajudante novo (não existe no repositório)?
     → type.assertCanCreate(repository.countByType(type))
  2. rules.assertCanSave(helper, demais ajudantes):
     nome único, sem sobreposição de pasta e
     pasta não sensível.
  3. Ligado → (re)registra no agendador.
     Desligado → remove do agendador.
  4. Só então salva a configuração: se o
     agendador falhar, nada é salvo e o erro
     chega à tela.
end note

note right of RunHelperUseCase
  Ponto de entrada da execução agendada.
  Escolhe o caso de uso com pattern matching
  no Helper selado. Ajudante desligado
  ou inexistente → não faz nada.
  Depois de executar: grava o ExecutionRecord
  (o que foi feito) e apaga os registros com
  mais de 30 dias. Falha na execução vira ação
  FAILED no registro e entra no log.
end note

note bottom of OrganizeFolderUseCase
  listEntries(pasta) → planner.plan → para cada FileMove:
  * destino livre → move
  * destino ocupado e sameContent → moveToTrash(origem)
    (DUPLICATE_TRASHED)
  * destino ocupado e conteúdo diferente
    → NumberedName.firstFree → move
  Pastas movidas com conflito de nome também
  ganham número. Arquivo em uso: próxima rodada.
end note

note bottom of CleanupUseCase
  RecycleBinTarget:
  * sem AgeLimit → recycleBin.emptyAll()
  * com AgeLimit → recycleBin.emptyOlderThan(agora - dias)
  FolderTarget: listEntries(pasta) → só arquivos
  soltos (sem subpastas) → filtra por AgeLimit e
  AgeReference → moveToTrash.
end note

note bottom of FileSystem
  listEntries devolve só o que está direto
  na pasta (arquivos e pastas), sem entrar
  nas subpastas.
end note

@enduml
