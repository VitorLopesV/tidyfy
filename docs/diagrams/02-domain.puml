@startuml domain
title Tidyfy — Domínio

skinparam shadowing false
skinparam classAttributeIconSize 0
set namespaceSeparator none
hide empty members

package "com.tidyfy.domain" {

  interface Helper <<sealed>> {
    + id() : HelperId
    + name() : HelperName
    + type() : HelperType
    + schedule() : Schedule
    + enabled() : boolean
    + withEnabled(enabled : boolean) : Helper
  }

  enum HelperType {
    FOLDER_ORGANIZER
    CLEANER
    DESKTOP_ARRANGER
    --
    + {static} MAX_PER_TYPE : int = 20
    + {static} MAX_DESKTOP_ARRANGERS : int = 1
    + assertCanCreate(existingCount : int) : void
  }

  class FolderOrganizerHelper <<record>> {
    + id : HelperId
    + name : HelperName
    + schedule : Schedule
    + enabled : boolean
    + folder : Path
    + type() : HelperType
    + withEnabled(enabled : boolean) : FolderOrganizerHelper
  }

  class CleanerHelper <<record>> {
    + id : HelperId
    + name : HelperName
    + schedule : Schedule
    + enabled : boolean
    + target : CleanupTarget
    + ageLimit : AgeLimit [0..1]
    + type() : HelperType
    + withEnabled(enabled : boolean) : CleanerHelper
  }

  class DesktopArrangerHelper <<record>> {
    + id : HelperId
    + name : HelperName
    + schedule : Schedule
    + enabled : boolean
    + layout : DesktopLayout
    + type() : HelperType
    + withEnabled(enabled : boolean) : DesktopArrangerHelper
  }

  enum DesktopLayout {
    LEFT
    RIGHT
    TOP
    BOTTOM
    BORDERS
    BY_TYPE_LEFT
  }

  interface CleanupTarget <<sealed>> {
  }

  class RecycleBinTarget <<record>> {
  }

  class FolderTarget <<record>> {
    + folder : Path
    + ageReference : AgeReference
  }

  class AgeLimit <<record>> {
    + days : int
    + isExceededBy(moment : Instant, now : Instant) : boolean
  }

  enum AgeReference {
    CREATED
    MODIFIED
  }

  class HelperId <<record>> {
    + value : UUID
    + {static} newId() : HelperId
  }

  class HelperName <<record>> {
    + value : String
  }

  class Schedule <<record>> {
    + intervalDays : int
    + times : List<LocalTime>
    + startDate : LocalDate
  }

  class ScheduleCalculator {
    - clock : Clock
    + nextExecution(schedule : Schedule) : LocalDateTime
    + previousExecution(schedule : Schedule) : Optional<LocalDateTime>
    + progress(schedule : Schedule) : double
  }

  class HelperRules {
    - protectedFolders : ProtectedFolders
    + assertCanSave(helper : Helper, others : List<Helper>) : void
  }

  class ProtectedFolders {
    + {static} forWindows(windowsDir : Path, programFiles : Path, programFilesX86 : Path, programData : Path, userHome : Path) : ProtectedFolders
    + assertAllowed(folder : Path) : void
  }

  class FolderEntry <<record>> {
    + path : Path
    + directory : boolean
    + createdAt : Instant
    + modifiedAt : Instant
  }

  class FileCategory <<record>> {
    + name : String
    + targetFolderName : String
    + extensions : Set<FileExtension>
    + matches(file : Path) : boolean
  }

  class FileExtension <<record>> {
    + value : String
    + {static} of(fileName : String) : Optional<FileExtension>
  }

  class DefaultFileCategories {
    + {static} all() : List<FileCategory>
  }

  class FileMove <<record>> {
    + source : Path
    + target : Path
  }

  class FolderOrganizationPlanner {
    + {static} OTHERS_FOLDER : String = "Outros"
    + {static} FOLDERS_FOLDER : String = "Pastas"
    - categories : List<FileCategory>
    + plan(folder : Path, entries : List<FolderEntry>) : List<FileMove>
  }

  class NumberedName {
    + {static} firstFree(name : String, exists : Predicate<String>) : String
  }

  class ExecutionRecord <<record>> {
    + {static} RETENTION_DAYS : int = 30
    + helperId : HelperId
    + helperName : String
    + executedAt : Instant
    + actions : List<HelperAction>
    + isExpired(now : Instant) : boolean
  }

  class HelperAction <<record>> {
    + type : ActionType
    + source : Path [0..1]
    + target : Path [0..1]
    + message : String [0..1]
  }

  enum ActionType {
    MOVED
    DUPLICATE_TRASHED
    TRASHED
    RECYCLE_BIN_EMPTIED
    FAILED
  }

  class DomainException <<exception>> {
  }

  class HelperLimitReachedException <<exception>> {
  }

  class DesktopArrangerAlreadyExistsException <<exception>> {
  }

  class HelperNameAlreadyUsedException <<exception>> {
  }

  class FolderAlreadyInUseException <<exception>> {
  }

  class ProtectedFolderException <<exception>> {
  }
}

Helper <|.. FolderOrganizerHelper
Helper <|.. CleanerHelper
Helper <|.. DesktopArrangerHelper
Helper --> "1" HelperId
Helper --> "1" HelperName
Helper --> "1" Schedule
ScheduleCalculator ..> Schedule : calcula
Helper ..> HelperType

DesktopArrangerHelper --> "1" DesktopLayout
CleanerHelper --> "1" CleanupTarget
CleanerHelper --> "0..1" AgeLimit
CleanupTarget <|.. RecycleBinTarget
CleanupTarget <|.. FolderTarget
FolderTarget --> "1" AgeReference

HelperRules ..> Helper : valida
HelperRules ..> ProtectedFolders : usa
HelperRules ..> HelperNameAlreadyUsedException : lança
HelperRules ..> FolderAlreadyInUseException : lança
ProtectedFolders ..> ProtectedFolderException : lança

FileCategory "1" *-- "1..*" FileExtension
DefaultFileCategories ..> FileCategory : cria
FolderOrganizationPlanner --> "*" FileCategory
FolderOrganizationPlanner ..> FolderEntry : lê
FolderOrganizationPlanner ..> FileMove : cria

ExecutionRecord "1" *-- "*" HelperAction
HelperAction --> "1" ActionType
ExecutionRecord --> "1" HelperId

DomainException <|-- HelperLimitReachedException
DomainException <|-- DesktopArrangerAlreadyExistsException
DomainException <|-- HelperNameAlreadyUsedException
DomainException <|-- FolderAlreadyInUseException
DomainException <|-- ProtectedFolderException
HelperType ..> HelperLimitReachedException : lança
HelperType ..> DesktopArrangerAlreadyExistsException : lança

note right of Helper
  Interface selada (sealed): só os
  ajudantes conhecidos. Cada ajudante
  atua em um único alvo (uma pasta,
  a lixeira ou a área de trabalho).
end note

note right of HelperType
  Limite de 20 ajudantes por tipo, exceto
  DESKTOP_ARRANGER, que é único (a área de
  trabalho é única). assertCanCreate lança
  exceção quando existingCount atinge o limite.
  Só é chamado na criação, nunca na edição.
end note

note bottom of CleanupTarget
  O que a Limpeza vai limpar:
  a lixeira do Windows ou uma pasta.
  Lixeira: remove de forma permanente.
  Pasta: manda só os arquivos soltos
  para a lixeira (subpastas não são tocadas).
end note

note bottom of AgeLimit
  "Quanto limpar": sem AgeLimit limpa tudo;
  com AgeLimit só o que é mais antigo que
  days (>= 1). Na pasta, a idade conta da
  criação ou da última modificação
  (AgeReference, escolha do usuário).
  Na lixeira, conta do dia em que o
  arquivo foi para lá.
end note

note left of HelperName
  Definido pelo usuário.
  Obrigatório, sem espaços nas pontas.
  Único entre os ajudantes, sem diferenciar
  maiúsculas (HelperRules).
end note

note bottom of ScheduleCalculator
  Próxima e anterior execução e o progresso (0 a 1)
  entre elas, para os cartões da lista. Os dias de
  execução são os que distam de startDate um múltiplo
  de intervalDays. Um horário igual a agora conta como
  já executado. Sem execução anterior, o progresso é 0.
end note

note left of Schedule
  A cada intervalDays dias (>= 1),
  em cada um dos horários de times
  (ao menos um, sem repetição).
  startDate: dia em que foi salvo ou teve a
  frequência alterada; é de onde se conta o intervalo.
  Sem limite máximo: o usuário define.
end note

note bottom of HelperRules
  others = os demais ajudantes (sem o próprio,
  na edição). Recusa quando:
  * o nome já existe;
  * a pasta é sensível (ProtectedFolders);
  * outro ajudante do mesmo tipo já atua na
    mesma pasta, ou numa pasta que contém ou
    está contida nela (Downloads e Downloads\Imagens);
  * a lixeira já tem um ajudante de limpeza.
  Organização e Limpeza podem dividir a pasta.
end note

note bottom of ProtectedFolders
  Recusa pastas sensíveis:
  * com tudo dentro: Windows (incluindo System32),
    Program Files, Program Files (x86), ProgramData;
  * só elas mesmas: raiz de qualquer disco e a
    pasta do usuário (Downloads, por exemplo, pode).
  Pura: recebe os caminhos prontos.
end note

note bottom of FolderOrganizationPlanner
  Função pura, não acessa o disco:
  * recebe só o que está direto na pasta
  * arquivo, extensão conhecida → pasta / categoria / arquivo
  * arquivo, extensão desconhecida → pasta / Outros / arquivo
  * pasta que não é do ajudante → pasta / Pastas / pasta
  * pastas do ajudante (categorias, Pastas e Outros)
    ficam onde estão
  Não entra nas pastas: elas são movidas inteiras.
end note

note right of DefaultFileCategories
  Catálogo fixo, sem categorias do usuário:
  Compactados, Documentos, Executáveis,
  Imagens e Vídeos. Pastas e Outros
  não têm extensões.
end note

note right of FileExtension
  Normalizada: minúscula e sem ponto
  (ex.: "Foto.JPG" → "jpg").
  Uma extensão pertence a só uma categoria.
end note

note right of NumberedName
  Resolve conflito de nome no destino:
  "teste.pdf" → "teste(1).pdf" → "teste(2).pdf".
  Pasta: "Fotos" → "Fotos(1)".
  exists diz se o nome já está ocupado.
end note

note bottom of ExecutionRecord
  Histórico: quando o ajudante rodou e o
  que fez (inclusive falhas, com FAILED e a
  mensagem). Guardado por 30 dias, mesmo se o
  ajudante for removido.
end note

@enduml
