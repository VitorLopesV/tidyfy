@startuml presentation
title Tidyfy — Apresentação e composição

skinparam shadowing false
skinparam classAttributeIconSize 0
set namespaceSeparator none
hide empty members

package "com.tidyfy" {

  class Main {
    + {static} main(args : String[]) : void
  }

  class LaunchArguments <<record>> {
    + mode : Mode
    + helperId : HelperId
    + error : String
    + {static} parse(args : String[]) : LaunchArguments
  }

  enum Mode {
    INTERFACE
    RUN
    INVALID
  }

  class HeadlessRunner {
    + EXIT_OK : int = 0
    + EXIT_FAILURE : int = 1
    + EXIT_INVALID_ARGUMENTS : int = 2
    + run(arguments : LaunchArguments) : int
  }

  class InterfaceLauncher {
    ~ {static} launch(args : String[]) : void
  }

  class AppContainer {
    + {static} create() : AppContainer
    + saveHelper() : SaveHelperUseCase
    + removeHelper() : RemoveHelperUseCase
    + listHelpers() : ListHelpersUseCase
    + listExecutionHistory() : ListExecutionHistoryUseCase
    + runHelper() : RunHelperUseCase
  }
}

package "com.tidyfy.presentation" {

  class TidyfyApplication {
    + start(stage : Stage) : void
  }

  class HelperListController {
    - listHelpers : ListHelpersUseCase
    - removeHelper : RemoveHelperUseCase
    - saveHelper : SaveHelperUseCase
    - selection : HelperSelection
    - filter : TypeFilter
    + createView() : Parent
    + showHelpers(items : List<HelperItem>) : void
  }

  class HelperTypeChooserController {
    + HelperTypeChooserController(organizers : int, cleaners : int)
    + createView() : Parent
    + chosenKind() : Optional<HelperKind>
  }

  abstract class HelperFormController {
    - editing : HelperItem
    + createView() : Parent
    # {abstract} viewName() : String
    # {abstract} targetMissing() : BooleanBinding
    # {abstract} showTarget(item : HelperItem) : void
  }

  class FolderOrganizerFormController {
    - saveHelper : SaveHelperUseCase
  }

  class CleanerFormController {
    - saveHelper : SaveHelperUseCase
  }

  class RemoveConfirmationController {
    + RemoveConfirmationController(items : List<HelperItem>)
    + createView() : Parent
    + isConfirmed() : boolean
  }

  class Dialogs <<utility>> {
    ~ {static} showModal(owner : Window, view : Parent, title : String) : void
  }
}

package "com.tidyfy.presentation.model" {

  class HelperItem <<record>> {
    + id : String
    + name : String
    + kind : HelperKind
    + folder : Path
    + intervalDays : int
    + times : List<LocalTime>
    + enabled : boolean
    + nextRun : String
    + nextRunProgress : double
    + targetsRecycleBin() : boolean
    + withEnabled(value : boolean) : HelperItem
  }

  enum HelperKind {
    ORGANIZER
    CLEANER
    --
    + {static} LIMIT_PER_TYPE : int = 20
  }

  enum TypeFilter {
    ALL
    ORGANIZER
    CLEANER
    --
    + matches(item : HelperItem) : boolean
  }

  class HelperSelection {
    + set(id : String, selected : boolean) : void
    + count() : int
    + canEdit() : boolean
    + canRemove() : boolean
    + editableId() : Optional<String>
  }

  class SchedulePreview <<utility>> {
    + {static} every(intervalDays : int) : String
    + {static} summary(intervalDays : int, times : List<LocalTime>) : String
    + {static} runCount(intervalDays : int, timesPerDay : int) : int
  }
}

package "com.tidyfy.presentation.component" {
  class HelperCard
  class CardGrid
  class UsageMeter
  class ToggleSwitch
  class FolderField
  class ScheduleEditor
  class UpcomingRunsCalendar
  class Icon
  enum Glyph
  class Logo
  class Pulse
  class DotGrid
  class Animations <<utility>>
  class Fxml <<utility>>
  class Nodes <<utility>>
}

package "javafx.application" {
  abstract class Application
}

package "com.tidyfy.infrastructure.logging" {
  class ExecutionLog
}

package "com.tidyfy.application.usecase" {
  class SaveHelperUseCase
  class RemoveHelperUseCase
  class ListHelpersUseCase
  class RunHelperUseCase
}

Application <|-- TidyfyApplication

Main --> LaunchArguments : interpreta os argumentos
LaunchArguments +-- Mode
Main ..> InterfaceLauncher : sem argumentos
InterfaceLauncher ..> TidyfyApplication : Application.launch
Main ..> HeadlessRunner : --run {id}
HeadlessRunner ..> AppContainer : cria sob demanda
HeadlessRunner ..> RunHelperUseCase : execute(id)
HeadlessRunner ..> ExecutionLog : started / finished / failed

TidyfyApplication --> HelperListController
HelperListController ..> HelperTypeChooserController : "Novo ajudante"
HelperListController ..> FolderOrganizerFormController : abre
HelperListController ..> CleanerFormController : abre
HelperListController ..> RemoveConfirmationController : "Remover"
HelperListController ..> Dialogs
HelperFormController <|-- FolderOrganizerFormController
HelperFormController <|-- CleanerFormController

HelperListController --> HelperSelection
HelperListController --> TypeFilter
HelperListController ..> HelperCard : um por ajudante
HelperListController ..> HelperItem
HelperFormController ..> ScheduleEditor
HelperFormController ..> UpcomingRunsCalendar
HelperCard ..> HelperItem
UpcomingRunsCalendar ..> SchedulePreview
HelperItem --> HelperKind

HelperListController --> ListHelpersUseCase
HelperListController --> RemoveHelperUseCase
HelperListController --> SaveHelperUseCase
FolderOrganizerFormController --> SaveHelperUseCase
CleanerFormController --> SaveHelperUseCase

note right of Main
  Dois modos de execução:
  * sem argumentos → abre a interface JavaFX
  * --run {id} → executa o ajudante e encerra,
    sem abrir interface (chamado pelo
    Agendador de Tarefas do Windows)
  Só o InterfaceLauncher referencia o JavaFX:
  o modo --run nunca o carrega. O HeadlessRunner
  devolve o código de saída (0 sucesso, 1 falha,
  2 argumentos inválidos); só o Main chama System.exit.
end note

note right of AppContainer
  Composition root: instancia as
  implementações da infraestrutura e
  injeta nos casos de uso (por construtor).
  create() usa os valores de produção;
  o construtor recebe as dependências
  externas (os testes usam dublês).
end note

note bottom of HelperListController
  Lista os ajudantes e permite ligar/desligar,
  editar e remover. "Novo ajudante" pede o tipo
  e abre o formulário correspondente.
  Edição só com um ajudante selecionado;
  remoção com um ou vários. As ações da
  seleção aparecem no lugar do filtro.
  A página não rola: só a área dos cartões,
  quando há mais ajudantes do que cabem.
  Mostra o uso por tipo (ex.: 12/20) e bloqueia
  a criação no limite; quem garante a regra
  é o domínio.
  Os casos de uso ainda não existem: a lista
  começa vazia e Salvar/Remover só fecham
  os diálogos.
end note

note bottom of HelperFormController
  Nome, frequência e ligado/desligado.
  Organização: uma pasta.
  Limpeza: lixeira ou uma pasta.
end note

note right of HelperItem
  Modelo de tela: o que a interface exibe.
  Será montado a partir do Helper do domínio.
  folder nulo = lixeira do Windows.
end note

note bottom of "com.tidyfy.presentation.component"
  Telas em FXML (src/main/resources/com/tidyfy/presentation)
  com tema escuro em tidyfy.css. Os controllers são criados
  no código e entregues ao FXMLLoader (Fxml.load), sem
  fx:controller, para permitir injeção por construtor.
end note

@enduml
