@startuml presentation
title Tidyfy — Apresentação e composição

skinparam shadowing false
skinparam classAttributeIconSize 0
set namespaceSeparator none
hide empty members

package "com.tidyfy" {

  class Main {
    + {static} main(args : String[]) : void
  }

  class LaunchArguments <<record>> {
    + mode : Mode
    + helperId : HelperId
    + error : String
    + {static} parse(args : String[]) : LaunchArguments
  }

  enum Mode {
    INTERFACE
    RUN
    REMOVE_TASKS
    INVALID
  }

  class RemoveTasksRunner {
    + RemoveTasksRunner(removeAllTasks : Supplier<RemoveAllTasksUseCase>, log : ExecutionLog, err : PrintStream)
    + EXIT_OK : int = 0
    + EXIT_FAILURE : int = 1
    + run() : int
  }

  class HeadlessRunner {
    + HeadlessRunner(runHelper : Supplier<RunHelperUseCase>, log : ExecutionLog, err : PrintStream)
    + EXIT_OK : int = 0
    + EXIT_FAILURE : int = 1
    + EXIT_INVALID_ARGUMENTS : int = 2
    + run(arguments : LaunchArguments) : int
  }

  class SchedulerSyncStarter {
    ~ SchedulerSyncStarter(syncScheduler : Supplier<SyncSchedulerUseCase>, log : ExecutionLog)
    ~ start() : Thread
    ~ run() : void
  }

  class InterfaceLauncher {
    ~ {static} launch(container : AppContainer, clock : Clock, args : String[]) : void
  }

  class AppContainer {
    + {static} create() : AppContainer
    + saveHelper() : SaveHelperUseCase
    + removeHelper() : RemoveHelperUseCase
    + listHelpers() : ListHelpersUseCase
    + listExecutionHistory() : ListExecutionHistoryUseCase
    + runHelper() : RunHelperUseCase
    + syncScheduler() : SyncSchedulerUseCase
    + removeAllTasks() : RemoveAllTasksUseCase
  }
}

package "com.tidyfy.presentation" {

  class TidyfyApplication {
    - {static} services : UiServices
    + {static} configure(services : UiServices) : void
    + start(stage : Stage) : void
  }

  class UiServices <<record>> {
    + listHelpers : ListHelpersUseCase
    + saveHelper : SaveHelperUseCase
    + removeHelper : RemoveHelperUseCase
    + listExecutionHistory : ListExecutionHistoryUseCase
    + clock : Clock
  }

  class HelperListController {
    - source : Supplier<List<HelperItem>>
    - errorHandler : Consumer<Throwable>
    - selection : HelperSelection
    - filter : TypeFilter
    + HelperListController()
    + HelperListController(listHelpers : ListHelpersUseCase, mapper : HelperItemMapper)
    + HelperListController(listHelpers : ListHelpersUseCase, mapper : HelperItemMapper, errorHandler : Consumer<Throwable>)
    + createView() : Parent
    + reload() : void
    + setErrorHandler(handler : Consumer<Throwable>) : void
    + showError(error : Throwable) : void
    + showHelpers(items : List<HelperItem>) : void
    + setSaveServices(saveHelper : SaveHelperUseCase, clock : Clock) : void
    + setRemoveService(removeHelper : RemoveHelperUseCase) : void
    + setHistoryLoader(historyLoader : Function<String, List<ExecutionItem>>) : void
    ~ afterRemoveConfirmation(confirmation : RemoveConfirmationController, chosen : List<HelperItem>) : void
    ~ createForm(kind : HelperKind, editing : HelperItem) : HelperFormController
    ~ afterForm(form : HelperFormController) : void
  }

  class HelperTypeChooserController {
    + HelperTypeChooserController(organizers : int, cleaners : int)
    + HelperTypeChooserController(organizers : int, cleaners : int, desktops : int)
    + createView() : Parent
    + chosenKind() : Optional<HelperKind>
  }

  abstract class HelperFormController {
    - editing : HelperItem
    - saveHelper : SaveHelperUseCase
    - clock : Clock
    - saved : boolean
    + createView() : Parent
    + saved() : boolean
    # {abstract} buildHelper(id : HelperId, name : HelperName, schedule : Schedule, enabled : boolean, editing : HelperItem) : Helper
    # {abstract} viewName() : String
    # {abstract} folderField() : FolderField
    # {abstract} targetMissing() : BooleanBinding
    # clearFolderError() : void
    # {abstract} showTarget(item : HelperItem) : void
  }

  class FolderOrganizerFormController {
    + FolderOrganizerFormController(editing : HelperItem)
    + FolderOrganizerFormController(editing : HelperItem, saveHelper : SaveHelperUseCase, clock : Clock)
  }

  class CleanerFormController {
    + CleanerFormController(editing : HelperItem)
    + CleanerFormController(editing : HelperItem, saveHelper : SaveHelperUseCase, clock : Clock)
  }

  class DesktopArrangerFormController {
    + DesktopArrangerFormController(editing : HelperItem)
    + DesktopArrangerFormController(editing : HelperItem, saveHelper : SaveHelperUseCase, clock : Clock)
    + selectedLayout() : DesktopLayout
  }

  class RemoveConfirmationController {
    + RemoveConfirmationController(items : List<HelperItem>)
    + createView() : Parent
    + isConfirmed() : boolean
  }

  class ExecutionHistoryController {
    + ExecutionHistoryController(helperName : String, items : List<ExecutionItem>)
    + createView() : Parent
  }

  class ErrorDialogController {
    + ErrorDialogController(error : ErrorMessage)
    + createView() : Parent
  }

  class ErrorMessage <<record>> {
    + title : String
    + message : String
    + details : String
  }

  class ErrorMessageMapper <<utility>> {
    + {static} toMessage(error : Throwable) : ErrorMessage
  }

  class Dialogs <<utility>> {
    ~ {static} showModal(owner : Window, view : Parent, title : String) : void
  }
}

package "com.tidyfy.presentation.model" {

  class HelperItem <<record>> {
    + id : String
    + name : String
    + kind : HelperKind
    + folder : Path
    + intervalDays : int
    + times : List<LocalTime>
    + enabled : boolean
    + nextRun : String
    + nextRunProgress : double
    + ageLimitDays : Integer
    + ageReference : HelperAgeReference
    + startDate : LocalDate
    + desktopLayout : DesktopLayout
    + targetsRecycleBin() : boolean
    + targetsDesktop() : boolean
    + withEnabled(value : boolean) : HelperItem
  }

  enum HelperKind {
    ORGANIZER
    CLEANER
    DESKTOP
    --
    + {static} LIMIT_PER_TYPE : int = 20
    + {static} LIMIT_DESKTOP : int = 1
    + limit() : int
  }

  enum TypeFilter {
    ALL
    ORGANIZER
    CLEANER
    DESKTOP
    --
    + matches(item : HelperItem) : boolean
  }

  class ExecutionItem <<record>> {
    + executedAt : String
    + summary : String
    + actions : List<ExecutionAction>
    + hasFailure() : boolean
  }

  class ExecutionAction <<record>> {
    + text : String
    + detail : String
    + failure : boolean
  }

  class HistoryLoader {
    + HistoryLoader(useCase : ListExecutionHistoryUseCase, mapper : ExecutionItemMapper)
    + apply(helperId : String) : List<ExecutionItem>
  }

  class ExecutionItemMapper {
    + ExecutionItemMapper(zone : ZoneId)
    + mapAll(records : List<ExecutionRecord>) : List<ExecutionItem>
    + map(record : ExecutionRecord) : ExecutionItem
  }

  class HelperItemMapper {
    + HelperItemMapper(clock : Clock)
    + toItems(helpers : List<Helper>) : List<HelperItem>
    + toItem(helper : Helper) : HelperItem
  }

  enum HelperAgeReference {
    CREATED
    MODIFIED
  }

  class HelperSelection {
    + set(id : String, selected : boolean) : void
    + count() : int
    + canEdit() : boolean
    + canRemove() : boolean
    + editableId() : Optional<String>
  }

  class SchedulePreview <<utility>> {
    + {static} every(intervalDays : int) : String
    + {static} summary(intervalDays : int, times : List<LocalTime>) : String
    + {static} runCount(intervalDays : int, timesPerDay : int) : int
  }
}

package "com.tidyfy.presentation.component" {
  class HelperCard
  class CardGrid
  class UsageMeter
  class LayoutThumbnail
  class ToggleSwitch
  class FolderField
  class ScheduleEditor
  class UpcomingRunsCalendar
  class Icon
  enum Glyph
  class Logo
  class Pulse
  class DotGrid
  class Animations <<utility>>
  class Fxml <<utility>>
  class Nodes <<utility>>
}

package "javafx.application" {
  abstract class Application
}

package "com.tidyfy.infrastructure.logging" {
  class ExecutionLog
}

package "com.tidyfy.application.usecase" {
  class SaveHelperUseCase
  class RemoveHelperUseCase
  class ListHelpersUseCase
  class ListExecutionHistoryUseCase
  class RunHelperUseCase
  class SyncSchedulerUseCase
  class RemoveAllTasksUseCase
}

package "com.tidyfy.domain" {
  class Helper
  class ExecutionRecord
}

Application <|-- TidyfyApplication

Main --> LaunchArguments : interpreta os argumentos
LaunchArguments +-- Mode
Main ..> SchedulerSyncStarter : sem argumentos (segundo plano)
SchedulerSyncStarter ..> AppContainer : syncScheduler()
Main ..> InterfaceLauncher : sem argumentos
InterfaceLauncher ..> TidyfyApplication : Application.launch
Main ..> HeadlessRunner : --run {id}
HeadlessRunner ..> AppContainer : cria sob demanda
HeadlessRunner ..> RunHelperUseCase : execute(id)
HeadlessRunner ..> ExecutionLog : started / finished / failed
Main ..> RemoveTasksRunner : --remove-tasks (desinstalador)
RemoveTasksRunner ..> AppContainer : cria sob demanda
RemoveTasksRunner ..> RemoveAllTasksUseCase : execute()
RemoveTasksRunner ..> ExecutionLog : info / error

InterfaceLauncher ..> UiServices : monta com os casos de uso do AppContainer
TidyfyApplication ..> UiServices : usa
UiServices o-- ListHelpersUseCase
UiServices o-- SaveHelperUseCase
UiServices o-- RemoveHelperUseCase
UiServices o-- ListExecutionHistoryUseCase
TidyfyApplication --> HelperListController : cria e liga os serviços
TidyfyApplication ..> HelperItemMapper : cria
TidyfyApplication ..> HistoryLoader : cria
TidyfyApplication ..> ExecutionItemMapper : cria
HelperListController ..> ListHelpersUseCase : reload()
HelperListController --> HelperItemMapper : converte Helper em HelperItem
HelperItemMapper ..> Helper
HelperItemMapper ..> HelperItem : cria
HelperListController ..> HelperTypeChooserController : "Novo ajudante"
HelperListController ..> FolderOrganizerFormController : abre
HelperListController ..> CleanerFormController : abre
HelperListController ..> DesktopArrangerFormController : abre
HelperListController ..> RemoveConfirmationController : "Remover"
HelperListController ..> ExecutionHistoryController : "Histórico"
HelperListController ..> ErrorDialogController : showError
HelperListController ..> ErrorMessageMapper
ErrorMessageMapper ..> ErrorMessage : converte Throwable
ErrorDialogController --> ErrorMessage
HelperListController ..> Dialogs
ExecutionHistoryController ..> ExecutionItem
ExecutionItem *-- ExecutionAction
ExecutionItemMapper ..> ExecutionItem : converte ExecutionRecord
ExecutionItemMapper ..> ExecutionRecord
HistoryLoader --> ExecutionItemMapper
HistoryLoader --> ListExecutionHistoryUseCase
HelperListController --> HistoryLoader : historyLoader (Function)
HelperFormController <|-- FolderOrganizerFormController
HelperFormController <|-- CleanerFormController
HelperFormController <|-- DesktopArrangerFormController
DesktopArrangerFormController ..> LayoutThumbnail

HelperListController --> HelperSelection
HelperListController --> TypeFilter
HelperListController ..> HelperCard : um por ajudante
HelperListController ..> HelperItem
HelperFormController ..> ScheduleEditor
HelperFormController ..> UpcomingRunsCalendar
HelperCard ..> HelperItem
UpcomingRunsCalendar ..> SchedulePreview
HelperItem --> HelperKind
HelperItem --> HelperAgeReference

HelperListController --> ListHelpersUseCase
HelperListController --> RemoveHelperUseCase : confirmar remoção
HelperListController --> SaveHelperUseCase
FolderOrganizerFormController --> SaveHelperUseCase
CleanerFormController --> SaveHelperUseCase
DesktopArrangerFormController --> SaveHelperUseCase

note right of Main
  Dois modos de execução:
  * sem argumentos → abre a interface JavaFX
  * --run {id} → executa o ajudante e encerra,
    sem abrir interface (chamado pelo
    Agendador de Tarefas do Windows)
  Só o InterfaceLauncher referencia o JavaFX:
  o modo --run nunca o carrega. O HeadlessRunner
  devolve o código de saída (0 sucesso, 1 falha,
  2 argumentos inválidos); só o Main chama System.exit.
end note

note right of AppContainer
  Composition root: instancia as
  implementações da infraestrutura e
  injeta nos casos de uso (por construtor).
  create() usa os valores de produção;
  o construtor recebe as dependências
  externas (os testes usam dublês).
end note

note bottom of HelperListController
  Lista os ajudantes e permite ligar/desligar,
  editar, remover e ver o histórico. "Novo ajudante" pede o tipo
  e abre o formulário correspondente.
  Edição só com um ajudante selecionado;
  remoção com um ou vários. As ações da
  seleção aparecem no lugar do filtro.
  A página não rola: só a área dos cartões,
  quando há mais ajudantes do que cabem.
  Mostra o uso por tipo (ex.: 12/20) e bloqueia
  a criação no limite; quem garante a regra
  é o domínio.
  A lista vem do ListHelpersUseCase; Salvar,
  Remover e o interruptor chamam os casos de uso
  e a lista é recarregada. Erros aparecem no
  diálogo de erro; o histórico, no diálogo
  de histórico (carregado pelo HistoryLoader).
end note

note bottom of HelperFormController
  Nome, frequência e ligado/desligado.
  Organização: uma pasta.
  Limpeza: lixeira ou uma pasta.
  Salvar monta o Helper do domínio e chama o
  SaveHelperUseCase; só fecha se der certo, senão
  mostra o erro no campo certo (nome repetido no
  nome; pasta em uso/protegida e lixeira em uso no
  folderError; o resto, como o limite, no rodapé). startDate = hoje ao criar
  ou quando a frequência muda.
end note

note right of HelperItem
  Modelo de tela: o que a interface exibe.
  Montado a partir do Helper do domínio
  pelo HelperItemMapper.
  folder nulo = lixeira do Windows.
end note

note bottom of "com.tidyfy.presentation.component"
  Telas em FXML (src/main/resources/com/tidyfy/presentation)
  com tema escuro em tidyfy.css. Os controllers são criados
  no código e entregues ao FXMLLoader (Fxml.load), sem
  fx:controller, para permitir injeção por construtor.
end note

@enduml
