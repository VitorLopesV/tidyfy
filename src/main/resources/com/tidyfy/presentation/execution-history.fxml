<?xml version="1.0" encoding="UTF-8"?>

<?import com.tidyfy.presentation.component.Icon?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" styleClass="dialog" prefWidth="640" prefHeight="600"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">

    <HBox styleClass="drag-handle" alignment="TOP_LEFT" spacing="16">
        <padding><Insets top="28" right="20" left="32"/></padding>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label fx:id="titleLabel" styleClass="chooser-title"/>
            <Label fx:id="subtitleLabel" styleClass="lead"/>
        </VBox>
        <Button fx:id="closeIconButton" styleClass="icon-btn" accessibleText="Fechar" onAction="#onClose">
            <graphic><Icon glyph="CLOSE" size="20"/></graphic>
        </Button>
    </HBox>

    <ScrollPane fx:id="historyScroll" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
        <VBox.margin><Insets top="20" right="20" left="32"/></VBox.margin>
        <VBox fx:id="itemsBox" spacing="12">
            <padding><Insets right="12" bottom="8"/></padding>
        </VBox>
    </ScrollPane>

    <VBox fx:id="emptyBox" styleClass="history-empty" alignment="CENTER" spacing="14" VBox.vgrow="ALWAYS">
        <StackPane styleClass="history-empty-badge" maxWidth="-Infinity">
            <Icon glyph="CLOCK" size="28"/>
        </StackPane>
        <Label fx:id="emptyLabel" styleClass="history-empty-title"/>
        <Label fx:id="emptyHintLabel" styleClass="lead-small" wrapText="true"/>
    </VBox>

    <HBox styleClass="dialog-footer" alignment="CENTER_LEFT" spacing="10">
        <Icon glyph="INFO" size="18"/>
        <Label fx:id="retentionLabel" styleClass="help"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="closeButton" text="Fechar" styleClass="btn, btn-ghost" onAction="#onClose"/>
    </HBox>
</VBox>
