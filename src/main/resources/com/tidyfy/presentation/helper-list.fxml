<?xml version="1.0" encoding="UTF-8"?>

<?import com.tidyfy.presentation.component.CardGrid?>
<?import com.tidyfy.presentation.component.DotGrid?>
<?import com.tidyfy.presentation.component.Icon?>
<?import com.tidyfy.presentation.component.Logo?>
<?import com.tidyfy.presentation.component.Pulse?>
<?import com.tidyfy.presentation.component.UsageMeter?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<!--
  A página não rola: cabeçalho, contadores e filtro ficam fixos e os cartões ocupam o espaço que sobra.
  Só a área dos cartões rola, e apenas quando há mais ajudantes do que cabem na janela.
-->
<StackPane fx:id="root" styleClass="app" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">

    <DotGrid prefHeight="320" maxHeight="320" StackPane.alignment="TOP_CENTER"/>

    <VBox maxWidth="1240" StackPane.alignment="TOP_CENTER">
        <padding><Insets top="24" right="40" bottom="24" left="40"/></padding>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Logo/>
            <Label text="Tidyfy" styleClass="wordmark"/>
        </HBox>

        <HBox alignment="BOTTOM_LEFT" spacing="24">
            <VBox.margin><Insets top="18"/></VBox.margin>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Seus ajudantes" styleClass="h1"/>
                <Label text="Tarefas de limpeza e organização que trabalham sozinhas no horário combinado, mesmo com o Tidyfy fechado."
                       styleClass="lead" wrapText="true" minHeight="-Infinity"/>
            </VBox>
            <Button fx:id="newHelperButton" text="Novo ajudante" styleClass="btn, btn-primary, btn-large"
                    minWidth="-Infinity" onAction="#onNewHelper">
                <graphic><Icon fx:id="newHelperIcon" glyph="PLUS" size="20"/></graphic>
            </Button>
        </HBox>

        <HBox spacing="16">
            <VBox.margin><Insets top="20"/></VBox.margin>

            <VBox styleClass="stat-card, kind-org" prefWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <StackPane styleClass="kind-badge, badge-34"><Icon glyph="FOLDER_SORTED" size="18"/></StackPane>
                    <VBox spacing="2">
                        <Label text="Organização de pasta" styleClass="stat-title"/>
                        <Label text="Até 20 ajudantes" styleClass="stat-sub"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox alignment="BASELINE_RIGHT">
                        <Label fx:id="organizerCount" text="0" styleClass="stat-count"/>
                        <Label text="/20" styleClass="stat-max"/>
                    </HBox>
                </HBox>
                <UsageMeter fx:id="organizerUsage"/>
            </VBox>

            <VBox styleClass="stat-card, kind-clean" prefWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <StackPane styleClass="kind-badge, badge-34"><Icon glyph="SPARKLES" size="18"/></StackPane>
                    <VBox spacing="2">
                        <Label text="Limpeza" styleClass="stat-title"/>
                        <Label text="Até 20 ajudantes" styleClass="stat-sub"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox alignment="BASELINE_RIGHT">
                        <Label fx:id="cleanerCount" text="0" styleClass="stat-count"/>
                        <Label text="/20" styleClass="stat-max"/>
                    </HBox>
                </HBox>
                <UsageMeter fx:id="cleanerUsage"/>
            </VBox>

            <VBox styleClass="stat-card, kind-desktop" prefWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <StackPane styleClass="kind-badge, badge-34"><Icon glyph="DESKTOP" size="18"/></StackPane>
                    <VBox spacing="2">
                        <Label text="Área de trabalho" styleClass="stat-title"/>
                        <Label text="Só um ajudante" styleClass="stat-sub"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox alignment="BASELINE_RIGHT">
                        <Label fx:id="desktopCount" text="0" styleClass="stat-count"/>
                        <Label text="/1" styleClass="stat-max"/>
                    </HBox>
                </HBox>
                <UsageMeter fx:id="desktopUsage" max="1"/>
            </VBox>

            <VBox styleClass="stat-card, live" prefWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10" minHeight="34">
                    <Pulse/>
                    <Label text="Ligados agora" styleClass="stat-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="enabledCount" text="0" styleClass="live-count" minWidth="-Infinity"/>
                </HBox>
                <Label text="Desligados saem do Agendador do Windows." styleClass="live-sub" wrapText="true"/>
            </VBox>
        </HBox>

        <VBox fx:id="listSection" spacing="12" VBox.vgrow="ALWAYS">
            <VBox.margin><Insets top="20"/></VBox.margin>

            <HBox alignment="CENTER_LEFT" spacing="16">
                <StackPane alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                    <HBox fx:id="filterBar" styleClass="segmented" alignment="CENTER_LEFT" spacing="4"
                          maxWidth="-Infinity" accessibleText="Filtrar por tipo">
                        <ToggleButton fx:id="filterAll" styleClass="seg">
                            <graphic>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label text="Todos" styleClass="seg-text"/>
                                    <Label fx:id="filterAllCount" text="0" styleClass="seg-count"/>
                                </HBox>
                            </graphic>
                        </ToggleButton>
                        <ToggleButton fx:id="filterOrganizer" styleClass="seg, kind-org">
                            <graphic>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Region styleClass="seg-dot"/>
                                    <Label text="Organização de pasta" styleClass="seg-text"/>
                                    <Label fx:id="filterOrganizerCount" text="0" styleClass="seg-count"/>
                                </HBox>
                            </graphic>
                        </ToggleButton>
                        <ToggleButton fx:id="filterCleaner" styleClass="seg, kind-clean">
                            <graphic>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Region styleClass="seg-dot"/>
                                    <Label text="Limpeza" styleClass="seg-text"/>
                                    <Label fx:id="filterCleanerCount" text="0" styleClass="seg-count"/>
                                </HBox>
                            </graphic>
                        </ToggleButton>
                        <ToggleButton fx:id="filterDesktop" styleClass="seg, kind-desktop">
                            <graphic>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Region styleClass="seg-dot"/>
                                    <Label text="Área de trabalho" styleClass="seg-text"/>
                                    <Label fx:id="filterDesktopCount" text="0" styleClass="seg-count"/>
                                </HBox>
                            </graphic>
                        </ToggleButton>
                    </HBox>

                    <HBox fx:id="selectionActions" alignment="CENTER_LEFT" spacing="14" maxWidth="-Infinity" visible="false">
                        <HBox styleClass="selection-bar" alignment="CENTER_LEFT" spacing="6"
                              accessibleText="Ações dos ajudantes selecionados">
                            <Label fx:id="selectionCount" styleClass="selection-count" minWidth="-Infinity"/>
                            <Label fx:id="selectionText" styleClass="selection-text" minWidth="-Infinity"/>
                            <Region styleClass="bar-divider"/>
                            <Button fx:id="editButton" text="Editar" styleClass="bar-btn" minWidth="-Infinity" onAction="#onEdit"
                                    accessibleHelp="A edição é feita um ajudante por vez.">
                                <graphic><Icon fx:id="editIcon" glyph="PENCIL" size="18"/></graphic>
                            </Button>
                            <Button fx:id="removeButton" text="Remover" styleClass="bar-btn, danger" minWidth="-Infinity" onAction="#onRemove">
                                <graphic><Icon glyph="TRASH" size="18"/></graphic>
                            </Button>
                            <Button fx:id="clearSelectionButton" styleClass="bar-btn, icon-only" minWidth="-Infinity" accessibleText="Limpar seleção"
                                    onAction="#onClearSelection">
                                <graphic><Icon glyph="CLOSE" size="18"/></graphic>
                            </Button>
                        </HBox>
                        <Label fx:id="editHint" text="Edite um ajudante por vez." styleClass="edit-hint" minWidth="0">
                            <graphic><Icon glyph="INFO" size="16"/></graphic>
                        </Label>
                    </HBox>
                </StackPane>
                <CheckBox fx:id="selectAll" text="Selecionar todos" styleClass="select-box, select-all" minWidth="-Infinity" onAction="#onSelectAll"/>
            </HBox>

            <ScrollPane fx:id="cardsScroll" fitToWidth="true" hbarPolicy="NEVER" styleClass="cards-scroll" minHeight="0" VBox.vgrow="ALWAYS">
                <VBox.margin><Insets top="-6" right="-8" left="-8"/></VBox.margin>
                <VBox>
                    <padding><Insets top="6" right="8" bottom="10" left="8"/></padding>
                    <CardGrid fx:id="cardGrid"/>
                    <Label fx:id="noResults" text="Nenhum ajudante deste tipo por aqui." styleClass="no-results"/>
                </VBox>
            </ScrollPane>
        </VBox>

        <VBox fx:id="emptyState" styleClass="empty-state" alignment="CENTER" spacing="12" VBox.vgrow="ALWAYS">
            <VBox.margin><Insets top="20"/></VBox.margin>
            <Group fx:id="emptyIllustration">
                <SVGPath content="M16 30a8 8 0 0 1 8-8h22l8 8h54a8 8 0 0 1 8 8v48a8 8 0 0 1-8 8H24a8 8 0 0 1-8-8z" styleClass="illus-folder"/>
                <SVGPath content="M34 52h44M34 62h30M34 72h18" styleClass="illus-lines"/>
                <Circle centerX="88" centerY="72" radius="4" styleClass="illus-dot"/>
                <SVGPath content="M108 4l2.4 6.6L117 13l-6.6 2.4L108 22l-2.4-6.6L99 13l6.6-2.4z" styleClass="illus-spark-clean"/>
                <SVGPath content="M10 6l1.4 3.6L15 11l-3.6 1.4L10 16l-1.4-3.6L5 11l3.6-1.4z" styleClass="illus-spark-org"/>
            </Group>
            <Label text="Nenhum ajudante por aqui" styleClass="empty-title"/>
            <Label text="Crie o primeiro para organizar uma pasta ou limpar a lixeira sem precisar lembrar disso."
                   styleClass="empty-text" wrapText="true" maxWidth="440"/>
            <Button fx:id="firstHelperButton" text="Criar primeiro ajudante" styleClass="btn, btn-primary, btn-large" onAction="#onNewHelper">
                <graphic><Icon fx:id="firstHelperIcon" glyph="PLUS" size="20"/></graphic>
            </Button>
        </VBox>
    </VBox>

    <Region fx:id="scrim" styleClass="scrim" visible="false"/>
</StackPane>
