<?xml version="1.0" encoding="UTF-8"?>

<?import com.tidyfy.presentation.component.Icon?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" styleClass="dialog" prefWidth="520"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">

    <VBox styleClass="drag-handle" spacing="18">
        <padding><Insets top="28" right="28" left="28"/></padding>
        <StackPane fx:id="dangerBadge" styleClass="danger-badge" maxWidth="-Infinity">
            <Icon glyph="ALERT" size="26"/>
        </StackPane>
        <VBox spacing="8">
            <Label fx:id="titleLabel" styleClass="confirm-title" wrapText="true"/>
            <Label fx:id="messageLabel" styleClass="lead-small" wrapText="true"/>
        </VBox>
    </VBox>

    <VBox fx:id="detailsBox" styleClass="error-details">
        <VBox.margin><Insets top="18" right="28" left="28"/></VBox.margin>
        <Label fx:id="detailsLabel" styleClass="error-details-text" wrapText="true"/>
    </VBox>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <padding><Insets top="20" right="28" bottom="24" left="28"/></padding>
        <Button fx:id="detailsButton" styleClass="btn, btn-ghost" onAction="#onToggleDetails"/>
        <Button fx:id="closeButton" text="Fechar" styleClass="btn, btn-primary" onAction="#onClose"
                defaultButton="true"/>
    </HBox>
</VBox>
