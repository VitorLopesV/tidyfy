<?xml version="1.0" encoding="UTF-8"?>

<?import com.tidyfy.presentation.component.FolderField?>
<?import com.tidyfy.presentation.component.Icon?>
<?import com.tidyfy.presentation.component.ScheduleEditor?>
<?import com.tidyfy.presentation.component.ToggleSwitch?>
<?import com.tidyfy.presentation.component.UpcomingRunsCalendar?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" styleClass="dialog, kind-clean" prefWidth="920" prefHeight="740"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <HBox styleClass="dialog-header, drag-handle" alignment="CENTER_LEFT" spacing="14">
            <StackPane styleClass="kind-badge, badge-42"><Icon glyph="SPARKLES" size="22"/></StackPane>
            <VBox alignment="CENTER_LEFT" spacing="2" HBox.hgrow="ALWAYS">
                <Label fx:id="titleLabel" styleClass="dialog-title"/>
                <Label text="Limpeza" styleClass="kind-caption, kind-text"/>
            </VBox>
            <Button styleClass="icon-btn" accessibleText="Fechar" onAction="#onClose">
                <graphic><Icon glyph="CLOSE" size="20"/></graphic>
            </Button>
        </HBox>
    </top>

    <center>
        <HBox>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="form-scroll" HBox.hgrow="ALWAYS">
                <VBox styleClass="form-body" spacing="18">
                    <VBox spacing="8">
                        <Label fx:id="nameTitle" text="Nome do ajudante" styleClass="field-label"/>
                        <TextField fx:id="nameField" promptText="Ex.: Esvaziar lixeira toda semana" styleClass="input"/>
                        <Label fx:id="nameHelp" styleClass="help" wrapText="true"/>
                    </VBox>

                    <VBox spacing="8">
                        <Label text="O que limpar" styleClass="field-label"/>
                        <GridPane hgap="10">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50"/>
                                <ColumnConstraints percentWidth="50"/>
                            </columnConstraints>
                            <ToggleButton fx:id="binChoice" styleClass="choice-card" maxWidth="Infinity"
                                          GridPane.columnIndex="0" accessibleText="Lixeira do Windows">
                                <graphic>
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <StackPane styleClass="kind-badge, badge-36"><Icon glyph="TRASH" size="18"/></StackPane>
                                        <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS">
                                            <Label text="Lixeira do Windows" styleClass="choice-title"/>
                                            <Label text="Esvazia a lixeira" styleClass="choice-desc"/>
                                        </VBox>
                                        <Region styleClass="radio-dot"/>
                                    </HBox>
                                </graphic>
                            </ToggleButton>
                            <ToggleButton fx:id="folderChoice" styleClass="choice-card" maxWidth="Infinity"
                                          GridPane.columnIndex="1" accessibleText="Uma pasta">
                                <graphic>
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <StackPane styleClass="kind-badge, badge-36"><Icon glyph="FOLDER" size="18"/></StackPane>
                                        <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS">
                                            <Label text="Uma pasta" styleClass="choice-title"/>
                                            <Label text="Remove seus arquivos" styleClass="choice-desc"/>
                                        </VBox>
                                        <Region styleClass="radio-dot"/>
                                    </HBox>
                                </graphic>
                            </ToggleButton>
                        </GridPane>
                    </VBox>

                    <VBox fx:id="folderSection" spacing="8">
                        <Label text="Pasta a limpar" styleClass="field-label"/>
                        <FolderField fx:id="folderField" chooserTitle="Escolher a pasta a limpar"/>
                    </VBox>

                    <Label fx:id="folderError" styleClass="help, error" wrapText="true">
                        <VBox.margin><Insets top="-14"/></VBox.margin>
                    </Label>

                    <VBox fx:id="ageSection" spacing="8">
                        <Label text="Quanto limpar" styleClass="field-label"/>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <HBox styleClass="segmented" alignment="CENTER_LEFT" spacing="4">
                                <ToggleButton fx:id="allChoice" text="Tudo" styleClass="seg, age-choice"/>
                                <ToggleButton fx:id="olderChoice" text="Só o que tem mais de" styleClass="seg, age-choice"/>
                            </HBox>
                            <HBox fx:id="ageStepperRow" alignment="CENTER_LEFT" spacing="10">
                                <HBox styleClass="stepper" alignment="CENTER" spacing="2">
                                    <Button fx:id="decreaseAge" styleClass="icon-btn" accessibleText="Diminuir dias" onAction="#onDecreaseAge">
                                        <graphic><Icon glyph="MINUS" size="18"/></graphic>
                                    </Button>
                                    <Label fx:id="ageDaysLabel" styleClass="stepper-value"/>
                                    <Button fx:id="increaseAge" styleClass="icon-btn" accessibleText="Aumentar dias" onAction="#onIncreaseAge">
                                        <graphic><Icon glyph="PLUS" size="18"/></graphic>
                                    </Button>
                                </HBox>
                                <Label fx:id="ageUnitLabel" styleClass="field-label"/>
                            </HBox>
                        </HBox>
                        <Label fx:id="ageHelp" styleClass="help" wrapText="true"/>
                    </VBox>

                    <VBox fx:id="referenceSection" spacing="8">
                        <Label text="Contar a idade a partir da" styleClass="field-label"/>
                        <HBox styleClass="segmented" alignment="CENTER_LEFT" spacing="4" maxWidth="-Infinity">
                            <ToggleButton fx:id="createdChoice" text="Data de criação" styleClass="seg, age-choice"/>
                            <ToggleButton fx:id="modifiedChoice" text="Última modificação" styleClass="seg, age-choice"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="14">
                        <Label text="Frequência" styleClass="field-label"/>
                        <ScheduleEditor fx:id="scheduleEditor"/>
                    </VBox>
                </VBox>
            </ScrollPane>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="preview-scroll">
                <VBox styleClass="preview-pane" spacing="14">
                    <Label text="PRÉVIA" styleClass="eyebrow"/>
                    <VBox spacing="10">
                        <Label text="O que acontece a cada execução" styleClass="h2"/>
                        <VBox fx:id="folderPreview" styleClass="preview-card" spacing="12">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <StackPane fx:id="folderPreviewBadge" styleClass="kind-badge, badge-44"><Icon glyph="FOLDER" size="22"/></StackPane>
                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                    <Label fx:id="previewFolderName" styleClass="h3"/>
                                    <Label text="Os arquivos desta pasta são removidos." styleClass="help" wrapText="true"/>
                                    <Label fx:id="folderAgeSummary" styleClass="help" wrapText="true"/>
                                </VBox>
                            </HBox>
                            <HBox styleClass="notice" alignment="TOP_LEFT" spacing="10">
                                <Icon glyph="ALERT" size="18"/>
                                <Label text="Escolha uma pasta só com arquivos descartáveis, como a de temporários."
                                       wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS"/>
                            </HBox>
                        </VBox>
                        <HBox fx:id="binPreview" styleClass="preview-card" alignment="CENTER_LEFT" spacing="14">
                            <StackPane fx:id="binPreviewBadge" styleClass="kind-badge, badge-56"><Icon glyph="TRASH" size="28"/></StackPane>
                            <VBox spacing="2">
                                <Label text="Lixeira do Windows" styleClass="h3"/>
                                <Label text="A lixeira é esvaziada." styleClass="help"/>
                                <Label fx:id="binAgeSummary" styleClass="help" wrapText="true"/>
                            </VBox>
                        </HBox>
                    </VBox>
                    <Separator/>
                    <UpcomingRunsCalendar fx:id="calendar"/>
                </VBox>
            </ScrollPane>
        </HBox>
    </center>

    <bottom>
        <HBox styleClass="dialog-footer" alignment="CENTER_LEFT" spacing="16">
            <ToggleSwitch fx:id="enabledSwitch"/>
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label fx:id="enabledTitle" styleClass="field-label"/>
                <Label fx:id="enabledHelp" styleClass="help"/>
                <Label fx:id="saveError" styleClass="help, error" wrapText="true"/>
            </VBox>
            <Button text="Cancelar" styleClass="btn, btn-ghost, btn-tall" onAction="#onClose"/>
            <Button fx:id="saveButton" styleClass="btn, btn-primary, btn-tall" onAction="#onSave">
                <graphic><Icon glyph="CHECK" size="18"/></graphic>
            </Button>
        </HBox>
    </bottom>
</BorderPane>
