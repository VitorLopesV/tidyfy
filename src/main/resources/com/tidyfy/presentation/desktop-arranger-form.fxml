<?xml version="1.0" encoding="UTF-8"?>

<?import com.tidyfy.presentation.component.Icon?>
<?import com.tidyfy.presentation.component.ScheduleEditor?>
<?import com.tidyfy.presentation.component.ToggleSwitch?>
<?import com.tidyfy.presentation.component.UpcomingRunsCalendar?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" styleClass="dialog, kind-desktop" prefWidth="1000" prefHeight="760"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <HBox styleClass="dialog-header, drag-handle" alignment="CENTER_LEFT" spacing="14">
            <StackPane styleClass="kind-badge, badge-42"><Icon glyph="DESKTOP" size="22"/></StackPane>
            <VBox alignment="CENTER_LEFT" spacing="2" HBox.hgrow="ALWAYS">
                <Label fx:id="titleLabel" styleClass="dialog-title"/>
                <Label text="Organizador da área de trabalho" styleClass="kind-caption, kind-text"/>
            </VBox>
            <Button styleClass="icon-btn" accessibleText="Fechar" onAction="#onClose">
                <graphic><Icon glyph="CLOSE" size="20"/></graphic>
            </Button>
        </HBox>
    </top>

    <center>
        <HBox>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="form-scroll" HBox.hgrow="ALWAYS">
                <VBox styleClass="form-body" spacing="22">
                    <VBox spacing="8">
                        <Label fx:id="nameTitle" text="Nome do ajudante" styleClass="field-label"/>
                        <TextField fx:id="nameField" promptText="Ex.: Arrumar a área de trabalho" styleClass="input"/>
                        <Label fx:id="nameHelp" styleClass="help" wrapText="true"/>
                    </VBox>

                    <VBox spacing="10">
                        <Label text="Onde ficam os ícones" styleClass="field-label"/>
                        <FlowPane fx:id="layoutOptions" hgap="12" vgap="12"/>
                        <Label text="Só existe um Organizador da área de trabalho. Nenhum arquivo é movido ou apagado: só a posição dos ícones muda."
                               styleClass="help" wrapText="true"/>
                        <HBox styleClass="notice" alignment="TOP_LEFT" spacing="10">
                            <Icon glyph="ALERT" size="18"/>
                            <Label text="Com “Organizar ícones automaticamente” ligado no Windows, o Tidyfy não consegue reposicionar os ícones e a execução falha."
                                   wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="14">
                        <Label text="Frequência" styleClass="field-label"/>
                        <ScheduleEditor fx:id="scheduleEditor"/>
                    </VBox>
                </VBox>
            </ScrollPane>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="preview-scroll">
                <VBox styleClass="preview-pane" spacing="14">
                    <Label text="PRÉVIA" styleClass="eyebrow"/>
                    <VBox spacing="10">
                        <Label text="Como a tela vai ficar" styleClass="h2"/>
                        <StackPane fx:id="previewHolder" alignment="CENTER_LEFT"/>
                        <Label fx:id="previewName" styleClass="h3"/>
                        <Label fx:id="previewDescription" styleClass="tree-note" wrapText="true" minHeight="-Infinity"/>
                        <Label text="Exemplo com ícones de vários tipos. Os ícones são posicionados em ordem de nome."
                               styleClass="tree-note" wrapText="true" minHeight="-Infinity"/>
                    </VBox>
                    <Separator/>
                    <UpcomingRunsCalendar fx:id="calendar"/>
                </VBox>
            </ScrollPane>
        </HBox>
    </center>

    <bottom>
        <HBox styleClass="dialog-footer" alignment="CENTER_LEFT" spacing="16">
            <ToggleSwitch fx:id="enabledSwitch"/>
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label fx:id="enabledTitle" styleClass="field-label"/>
                <Label fx:id="enabledHelp" styleClass="help"/>
                <Label fx:id="saveError" styleClass="help, error" wrapText="true"/>
            </VBox>
            <Button text="Cancelar" styleClass="btn, btn-ghost, btn-tall" onAction="#onClose"/>
            <Button fx:id="saveButton" styleClass="btn, btn-primary, btn-tall" onAction="#onSave">
                <graphic><Icon glyph="CHECK" size="18"/></graphic>
            </Button>
        </HBox>
    </bottom>
</BorderPane>
