<?xml version="1.0" encoding="UTF-8"?>

<?import com.tidyfy.presentation.component.Icon?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" styleClass="dialog" prefWidth="520"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">

    <VBox styleClass="drag-handle" spacing="18">
        <padding><Insets top="28" right="28" left="28"/></padding>
        <StackPane fx:id="dangerBadge" styleClass="danger-badge" maxWidth="-Infinity">
            <Icon glyph="TRASH" size="26"/>
        </StackPane>
        <VBox spacing="8">
            <Label fx:id="titleLabel" styleClass="confirm-title"/>
            <Label text="Eles deixam de rodar e saem do Agendador do Windows. As pastas e os arquivos continuam como estão."
                   styleClass="lead-small" wrapText="true"/>
        </VBox>
    </VBox>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" maxHeight="240" styleClass="list-scroll">
        <VBox.margin><Insets top="18" right="28" left="28"/></VBox.margin>
        <VBox fx:id="itemsBox" spacing="8"/>
    </ScrollPane>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <padding><Insets top="20" right="28" bottom="24" left="28"/></padding>
        <Button text="Cancelar" styleClass="btn, btn-ghost" onAction="#onCancel"/>
        <Button fx:id="confirmButton" styleClass="btn, btn-danger" onAction="#onConfirm">
            <graphic><Icon glyph="TRASH" size="18"/></graphic>
        </Button>
    </HBox>
</VBox>
