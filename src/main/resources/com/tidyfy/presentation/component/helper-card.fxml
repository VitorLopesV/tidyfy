<?xml version="1.0" encoding="UTF-8"?>

<?import com.tidyfy.presentation.component.Icon?>
<?import com.tidyfy.presentation.component.Pulse?>
<?import com.tidyfy.presentation.component.ToggleSwitch?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<fx:root type="javafx.scene.layout.VBox" styleClass="helper-card"
         xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">

    <HBox alignment="CENTER_LEFT" spacing="10" minHeight="44">
        <CheckBox fx:id="selectBox" styleClass="select-box"/>
        <StackPane fx:id="kindBadge" styleClass="kind-badge, badge-36">
            <Icon fx:id="kindIcon" size="19"/>
        </StackPane>
        <VBox spacing="1" minWidth="0" HBox.hgrow="ALWAYS">
            <Label fx:id="nameLabel" styleClass="card-name" maxWidth="Infinity"/>
            <Label fx:id="kindLabel" styleClass="kind-label, kind-text"/>
        </VBox>
        <ToggleSwitch fx:id="enabledSwitch"/>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="8">
        <Icon fx:id="targetIcon" size="16"/>
        <Label fx:id="targetName" styleClass="target-name" minWidth="-Infinity"/>
        <Label fx:id="targetDetail" styleClass="target-detail" minWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="8">
        <Icon glyph="CLOCK" size="15"/>
        <Label fx:id="everyLabel" styleClass="every-label" minWidth="-Infinity"/>
        <HBox fx:id="timeChips" alignment="CENTER_LEFT" spacing="4" minWidth="-Infinity"/>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox fx:id="nextRunBox" alignment="CENTER_RIGHT" spacing="7" minWidth="-Infinity">
            <Pulse/>
            <Label fx:id="nextRunLabel" styleClass="next-value"/>
        </HBox>
        <HBox fx:id="pausedBox" alignment="CENTER_RIGHT" spacing="6" minWidth="-Infinity">
            <Icon glyph="PAUSE" size="15"/>
            <Label text="Pausado" styleClass="schedule-text"/>
        </HBox>
    </HBox>

    <StackPane fx:id="progressTrack" styleClass="progress-track" alignment="CENTER_LEFT">
        <Region fx:id="progressFill" styleClass="progress-fill" maxWidth="-Infinity"/>
    </StackPane>
</fx:root>
